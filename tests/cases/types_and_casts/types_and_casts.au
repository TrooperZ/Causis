let unsignedByte: uint8 = 255;
let signedByte: int8 = -128;
let unsignedShort: uint16 = 65535;
let signedShort: int16 = -32768;
let unsignedInt: uint32 = 0;
let signedInt: int32 = 42;
let unsignedLong: uint64 = 99;
let signedLong: int64 = -100;
let smallFloat: float32 = 1.5;
let largeFloat: float64 = cast_as<float64>(signedInt);
let truncated: int32 = cast_as<int32>(3.75);

print(unsignedByte);
print("\n");
print(signedByte);
print("\n");
print(unsignedShort);
print("\n");
print(signedShort);
print("\n");
print(unsignedInt);
print("\n");
print(signedInt);
print("\n");
print(unsignedLong);
print("\n");
print(signedLong);
print("\n");
print(smallFloat);
print("\n");
print(largeFloat);
print("\n");
print(truncated);
print("\n");
